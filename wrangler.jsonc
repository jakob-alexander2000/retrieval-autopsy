{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retrieval-autopsy",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
